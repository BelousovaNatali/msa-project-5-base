@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров TradeWare с мониторингом и логированием

Person(worker, "Сотрудник склада", "Загружает отчёты об остатках")
Person(admin, "Администратор", "Мониторит систему и реагирует на инциденты")
Person(dev, "Разработчик", "Анализирует логи и ошибки")

System_Boundary(tradeware, "TradeWare System") {

    Container(frontend, "Веб-интерфейс", "Интерфейс для загрузки отчётов и просмотра остатков")

    Container(api, "API Gateway", "Маршрутизация запросов, аутентификация")

    Container(monolith, "Монолитное приложение", "Основная бизнес-логика (постепенно выносится)")

    Container(batch, "Spring Batch", "ETL-обработка CSV-файлов")

    Container(scheduler, "Планировщик", "Spring Scheduler", "Запуск пакетных задач по расписанию")

    ContainerDb(db, "Основная БД", "PostgreSQL", "Хранит данные о товарах, остатках, справочниках")

    ContainerDb(metadata, "Метаданные Spring Batch", "PostgreSQL", "Хранит статусы Job и Step")

    Container(storage, "Файловое хранилище", "Google Cloud Storage", "Хранит загруженные CSV-файлы")
}

System_Boundary(monitoring_system, "Система мониторинга и логирования") {

    Container(prometheus, "Prometheus", "Сбор метрик")

    Container(grafana, "Grafana", "Визуализация метрик и дашборды")

    Container(alertmanager, "Alertmanager", "Управление оповещениями")

    Container(elasticsearch, "Elasticsearch", "Хранение и индексация логов")

    Container(logstash, "Logstash", "Обработка и обогащение логов")

    Container(kibana, "Kibana", "Визуализация логов и поиск")
}

System_Ext(notification, "Каналы оповещений", "Email, Telegram")

Rel(worker, frontend, "Загружает CSV-файл")
Rel(frontend, api, "Отправляет запросы")
Rel(api, monolith, "Маршрутизирует запросы")
Rel(api, batch, "Запускает Batch Job")

Rel(batch, storage, "Читает CSV-файл")
Rel(batch, db, "Читает справочники")
Rel(batch, db, "Записывает обработанные данные")
Rel(batch, metadata, "Сохраняет статус Job")

Rel(scheduler, batch, "Запускает ночные задачи")

Rel(monolith, prometheus, "Экспортирует метрики")
Rel(batch, prometheus, "Экспортирует метрики")
Rel(prometheus, grafana, "Предоставляет данные для дашбордов")
Rel(prometheus, alertmanager, "Отправляет алерты")

Rel(monolith, logstash, "Отправляет логи")
Rel(batch, logstash, "Отправляет логи")
Rel(logstash, elasticsearch, "Индексирует логи")
Rel(elasticsearch, kibana, "Предоставляет данные для поиска")

Rel(alertmanager, notification, "Отправляет оповещения")
Rel(admin, grafana, "Просматривает дашборды")
Rel(dev, kibana, "Анализирует логи и ошибки")

@enduml