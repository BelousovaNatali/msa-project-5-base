@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров TradeWare с Spring Batch (To-Be)

Person(worker, "Сотрудник склада", "Загружает отчёты об остатках")
Person(manager, "Менеджер", "Просматривает отчёты и аналитику")
Person(partner, "Логистический партнёр", "Получает данные о перемещениях")

System_Boundary(tradeware, "TradeWare System") {

    Container(frontend, "Веб-интерфейс", "Angular, WebSockets", "Интерфейс для загрузки отчётов и просмотра остатков")

    Container(api, "API Gateway", "Spring Cloud Gateway", "Маршрутизация запросов, аутентификация")

    Container(monolith, "Монолитное приложение", "Java 11, WildFly", "Основная бизнес-логика (постепенно выносится)")

    Container(batch, "Spring Batch", "Java 11, Spring Boot", "ETL-обработка CSV-файлов")

    Container(scheduler, "Планировщик", "Spring Scheduler", "Запуск пакетных задач по расписанию")

    ContainerDb(db, "Основная БД", "PostgreSQL", "Хранит данные о товарах, остатках, справочниках")

    ContainerDb(metadata, "Метаданные Spring Batch", "PostgreSQL", "Хранит статусы Job и Step")

    Container(storage, "Файловое хранилище", "Google Cloud Storage", "Хранит загруженные CSV-файлы")
}

Rel(worker, frontend, "Загружает CSV-файл", "HTTPS")
Rel(manager, frontend, "Просматривает остатки", "HTTPS")
Rel(partner, api, "Получает данные о перемещениях", "REST API")
Rel(frontend, api, "Отправляет запросы", "REST API")
Rel(api, monolith, "Маршрутизирует запросы", "HTTP")
Rel(api, batch, "Запускает Batch Job", "HTTP")

Rel(batch, storage, "Читает CSV-файл", "GCS API")
Rel(batch, db, "Читает справочники", "JDBC")
Rel(batch, db, "Записывает обработанные данные", "JDBC")
Rel(batch, metadata, "Сохраняет статус Job", "JDBC")

Rel(scheduler, batch, "Запускает ночные задачи", "HTTP")

@enduml